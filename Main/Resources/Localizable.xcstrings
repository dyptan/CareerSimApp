    },
    "A poster, an experiment, and a judge with a clipboard." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Poster, ein Experiment und ein Juror mit Klemmbrett."
