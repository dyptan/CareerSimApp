    "I can only take your answers from the buttons right now — pick one below." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade kann ich Antworten nur über die Buttons annehmen – wähle unten eine aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour l’instant, je ne peux prendre tes réponses que via les boutons — choisis-en un ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora posso accettare le tue risposte solo dai pulsanti — scegline uno qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いまはボタンからの回答だけ受け付けています。下から選んでくださいね。"
