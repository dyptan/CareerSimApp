    "Hairdressers, therapists and trainers show off their skills." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Friseure, Therapeuten und Trainer zeigen ihr Können."
          }
        },
