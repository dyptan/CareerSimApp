      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist durchgestartet: Der Umsatz hat sich verdreifacht und dein Anteil ist jetzt ein Vielfaches wert. Verkauf ihn in der Chefetage oder reite die Welle einfach weiter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impresa «%@» è decollata: i ricavi sono triplicati e la tua quota ora vale molte volte di più. Vendila nella Sala del consiglio, oppure continua a cavalcare l’onda."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бізнес «%@» злетів: виручка зросла втричі, а твоя частка тепер коштує в рази більше. Продай її в розділі «Правління» або тримай далі й їдь на хвилі успіху."
          }
