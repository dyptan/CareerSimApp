    "Play Music Gigs" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Live-Musik spielen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Donner des concerts"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona dal vivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音楽ライブ出演"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грати на концертах"
          }
        }
      }
    },
    "Play weddings, cafés and shows of your own." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele auf Hochzeiten, in Cafés und bei eigenen Shows."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue dans des mariages et des cafés, et donne tes propres concerts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona ai matrimoni, nei caffè e nei tuoi spettacoli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結婚式やカフェ、自分のライブで演奏します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грай на весіллях, у кафе й на власних шоу."
          }
        }
      }
    },
    "Play weddings, cafés and your own shows. It's how most musicians practise in front of people — and every crowd is a chance to be noticed." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele auf Hochzeiten, in Cafés und bei eigenen Shows. So üben die meisten Musiker vor Publikum – und jedes Publikum ist eine Chance, entdeckt zu werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue dans des mariages, des cafés et à tes propres concerts. C’est ainsi que la plupart des musiciens s’entraînent devant du public — et chaque public est une chance de se faire remarquer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona ai matrimoni, nei caffè e nei tuoi spettacoli. È così che la maggior parte dei musicisti si esercita davanti al pubblico — e ogni platea è un’occasione per farsi notare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "結婚式やカフェ、自分のライブで演奏します。多くのミュージシャンが、ここで人前での演奏の経験を積みます。観客が集まるたびに、名前を知ってもらうチャンスです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Грай на весіллях, у кафе й на власних шоу. Так більшість музикантів тренуються виступати перед людьми — і кожна публіка дає шанс, що тебе помітять."
          }
        }
      }
    },
    "Play your music on the festival stage in front of a big crowd." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiel deine Musik auf der Festivalbühne vor einem großen Publikum."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue ta musique sur la scène du festival devant une grande foule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suona la tua musica sul palco del festival davanti a una grande folla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フェスのステージで、大勢の観客の前で音楽を演奏します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіграй свою музику на сцені фестивалю перед великою публікою."
          }
        }
      }
    },
