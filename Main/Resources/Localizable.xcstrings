    },
    "%@ had to close this year. Selling what was left got back %@ — but you still have to pay back any loan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Unternehmen „%1$@“ musste dieses Jahr schließen. Der Verkauf des Restes brachte %2$@ ein – einen eventuellen Kredit musst du aber trotzdem zurückzahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ had to close this year. Selling what was left got back %2$@ — but you still have to pay back any loan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entreprise « %1$@ » a dû fermer cette année. La vente de ce qui restait t’a rapporté %2$@ — mais tu dois encore rembourser les prêts éventuels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impresa «%1$@» ha dovuto chiudere quest’anno. Vendendo ciò che restava hai recuperato %2$@ — ma devi comunque restituire l’eventuale prestito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は今年、廃業することになりました。残ったものを売って%2$@を取り戻しましたが、起業ローンが残っている場合は返済が必要です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бізнес «%1$@» довелося закрити цього року. Продаж залишків повернув %2$@ — але кредит, якщо він є, усе одно потрібно погасити."
          }
        }
      }
    },
