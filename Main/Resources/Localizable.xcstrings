    "Ages 7+ · easiest" : {
      "comment" : "Audience chip on the Simplified game-mode card: the youngest players, the gentlest mode.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab 7 Jahren · am einfachsten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès 7 ans · le plus facile"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da 7 anni · il più facile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7歳以上 · いちばんかんたん"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від 7 років · найлегший"
          }
        }
      }
    },
    "Ages 7+ · easiest. The gentlest way in — a good first game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab 7 Jahren · am einfachsten. Ein sanfter Einstieg – ein gutes erstes Spiel."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dès 7 ans · le plus facile. L’entrée en douceur — un bon premier jeu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da 7 anni · il più facile. Il modo più tranquillo per iniziare — un ottimo primo gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7歳以上 · いちばんかんたん。はじめてでも安心の入り口で、最初のゲームにぴったりです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від 7 років · найлегший. Мʼякий старт — добра перша гра."
          }
        }
      }
    },
    "Ages roughly 11–13. Subjects branch out into science, history, languages, and the arts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alter: etwa 11–13 Jahre. Die Fächer werden vielfältiger: Naturwissenschaften, Geschichte, Sprachen und Kunst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 11 à 13 ans environ. Les matières se diversifient : sciences, histoire, langues et arts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagli 11 ai 13 anni circa. Le materie si ampliano: scienze, storia, lingue e arti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "11〜13歳ごろ。理科、歴史、外国語、芸術など、教科が広がっていきます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вік: приблизно 11–13 років. Предмети розгалужуються: природничі науки, історія, мови та мистецтво."
          }
        }
      }
    },
    "Ages roughly 14–17. A diploma is needed for most jobs and to apply to college or vocational programmes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alter: etwa 14–17 Jahre. Für die meisten Jobs brauchst du einen Schulabschluss, ebenso für die Bewerbung an einer Hochschule oder in beruflichen Programmen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 14 à 17 ans environ. Un diplôme est nécessaire pour la plupart des postes et pour postuler à l’université ou à une formation professionnelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai 14 ai 17 anni circa. Il diploma serve per la maggior parte dei lavori e per candidarsi all’università o ai corsi professionali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "14〜17歳ごろ。高校卒業資格は、ほとんどの仕事で求められ、大学や職業プログラムへの出願にも必要です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вік: приблизно 14–17 років. Диплом про закінчення школи потрібен для більшості робіт і для вступу до коледжу чи на фахові програми."
          }
        }
      }
    },
    "Ages roughly 6–10. Reading, writing, basic math — the foundation everything else builds on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alter: etwa 6–10 Jahre. Lesen, Schreiben, Grundrechnen – das Fundament, auf dem alles andere aufbaut."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De 6 à 10 ans environ. Lecture, écriture, calcul de base — les fondations de tout le reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai 6 ai 10 anni circa. Lettura, scrittura e matematica di base — le fondamenta su cui si costruisce tutto il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6〜10歳ごろ。読み書きや基本の算数など、すべての土台になることを学びます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вік: приблизно 6–10 років. Читання, письмо, основи математики — фундамент, на якому тримається все інше."
          }
        }
      }
    },
    "Agriculture" : {
