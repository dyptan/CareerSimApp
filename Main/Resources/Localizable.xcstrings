    },
    "Architecture Licensure (Architect License)" : {},
    "Arguing a case against the clock — research it, build it, and persuade a room." : {},
    "Art Contest Winner" : {},
    "Arts" : {
      "comment" : "A field of fame: the creative arts - painting, design, writing, language. Plural noun, not the school subject.\nField of study (degree subject): visual, performing and creative arts (music, drawing, acting, cooking)."
    },
    "Arts & Minds" : {
