          }
        }
      }
    },
    "The world stage. Medal here and you're a household name for life — the summit of a long career." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Weltbühne. Hol hier eine Medaille, und du bist ein Leben lang ein bekannter Name – der Gipfel einer langen Karriere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scène mondiale. Décroche une médaille ici et ton nom reste célèbre toute ta vie — le sommet d’une longue carrière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il palcoscenico mondiale. Vinci una medaglia qui e il tuo nome lo conoscono tutti per sempre — la vetta di una lunga carriera."
