          "stringUnit" : {
            "state" : "translated",
            "value" : "Cinque problemi difficili, cinque ore, niente internet."
          }
        }
      }
    },
    "Five-a-side basketball. Fast-paced team sport rewarding agility, teamwork, and split-second decisions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketball, fünf gegen fünf. Ein rasanter Teamsport, der Beweglichkeit, Zusammenspiel und Entscheidungen in Sekundenbruchteilen belohnt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket a cinque. Sport di squadra veloce che premia agilità, gioco di squadra e decisioni prese in un istante."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Баскетбол 5 на 5. Швидкий командний спорт, що винагороджує спритність, командну роботу й миттєві рішення."
          }
        }
      }
    },
    "Fixer" : {
