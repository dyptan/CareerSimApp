    "School costs little here, but it takes many years before the first full salary." : {
      "comment" : "Health specialist note, point 4b: the same fact in a beginner's or child's words. Germany, France and Italy only",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schule kostet hier wenig, aber es dauert viele Jahre bis zum ersten vollen Gehalt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les études coûtent peu ici, mais il faut de nombreuses années avant le premier salaire complet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui la scuola costa poco, ma passano molti anni prima del primo stipendio pieno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここでは学校にあまりお金はかかりませんが、最初の本格的な給料をもらうまでには何年もかかります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навчання тут коштує небагато, але до першої повної зарплати минає багато років."
          }
        }
      }
    },
    "School prestige" : {
      "comment" : "Name of a lever on the player's hire chance in the career advisor: how well-regarded the school behind the degree is",
      "localizations" : {
