    "Legal, justice, and social order." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recht, Gerechtigkeit und gesellschaftliche Ordnung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
