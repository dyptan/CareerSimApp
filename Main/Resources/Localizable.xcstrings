          }
        }
      }
    },
    "The National Living Wage (£12.71 an hour)" : {
      "comment" : "Noun phrase naming the minimum-wage rule in United Kingdom. It leads the picker line \"<this>: no job pays under <amount> a year.\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
