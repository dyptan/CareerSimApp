    "Not hiring right now" : {
      "comment" : "Title of an advisor card: nobody is posting the player's goal role this year",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerade stellt niemand ein"
