    "Pitch your business idea on stage and try to win." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pitche deine Geschäftsidee auf der Bühne und versuche zu gewinnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Défends ton idée d’entreprise sur scène et tente de gagner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presenta la tua idea imprenditoriale sul palco e prova a vincere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステージでビジネスのアイデアをピッチして、優勝をめざします。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виступи на сцені з пітчем своєї бізнес-ідеї й спробуй перемогти."
          }
        }
      }
    },
    "Planner" : {
      "comment" : "Name of a skill (ability) the player builds, shown next to a pictogram and used as a playful job-like title. The skill: Organising your days and finishing things on time.",
