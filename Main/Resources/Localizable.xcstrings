        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "いま特に効果が出やすい行動を、おすすめ順に紹介します："
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ось кроки, які зараз дають найбільше, від найкращого:"
          }
        }
      }
    },
    "Here's how this works in real life — and how the game plays it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "So funktioniert das im echten Leben – und so spielt das Spiel es nach."
          }
        },
        "fr" : {
          "stringUnit" : {
