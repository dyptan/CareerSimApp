      }
    },
    "Specialty board certification earned after residency — the standard credential for attending physicians and medical leadership. Verifies mastery of a medical specialty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facharzt-Zertifizierung, die du nach der Facharztausbildung erwirbst – die Standardqualifikation für Fachärzte und die medizinische Leitung. Sie bestätigt, dass du ein medizinisches Fachgebiet meisterhaft beherrschst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certification de spécialité, qui s’obtient après l’internat — la qualification de référence des médecins titulaires et de la direction médicale. Elle atteste la maîtrise d’une spécialité médicale."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificazione di specialità conseguita dopo la specializzazione medica — la qualifica standard per i medici strutturati e per la direzione sanitaria. Attesta la padronanza di una specialità medica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "専門医認定：臨床研修のあとに得られる、指導医や医療のリーダーに求められる標準的な資格です。医療の専門分野を極めた証になります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертифікація спеціаліста, яку здобувають після інтернатури, — стандартна кваліфікація для лікуючих лікарів і медичного керівництва. Підтверджує майстерність у медичній спеціальності."
          }
        }
      }
    },
