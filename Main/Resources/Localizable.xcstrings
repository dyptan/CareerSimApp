    "🌟 Every year in business, every investment you win and every sale makes you better known in %@ %@ — so your next business is more likely to last." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 Jedes Jahr im Geschäft, jede gewonnene Finanzierungsrunde und jeder Verkauf machen dich in %1$@ %2$@ bekannter – so hält dein nächstes Unternehmen eher durch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🌟 Every year in business, every investment you win and every sale makes you better known in %1$@ %2$@ — so your next business is more likely to last."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 Chaque année d’activité, chaque levée de fonds obtenue et chaque vente te font connaître davantage en %1$@ %2$@ — ta prochaine entreprise a donc plus de chances de durer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 Ogni anno di attività, ogni investimento che ottieni e ogni vendita aumentano la tua fama nel settore %1$@ %2$@ — così la tua prossima impresa ha più probabilità di durare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 事業を続けた年、出資を勝ち取るたび、売却するたびに、%1$@ %2$@での名声が高まり、次の事業が長続きしやすくなります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 Кожен рік у бізнесі, кожна здобута інвестиція та кожен продаж збільшують твою славу у сфері %1$@ «%2$@» — тож наступний бізнес із більшим шансом проіснує довго."
          }
        }
      }
    },
    "🌟 Your %@ fame went from %@ to %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 Dein Ruhm in %1$@ ist von %2$@ auf %3$@ gestiegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🌟 Your %1$@ fame went from %2$@ to %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 Ta renommée en %1$@ est passée de %2$@ à %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 La tua fama nel settore %1$@ è passata da %2$@ a %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🌟 %1$@の名声が%2$@から%3$@に上がりました。"
          }
        },
