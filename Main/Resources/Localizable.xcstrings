    "📊 Feels the economy less than most — people still need it in hard times." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Spürt die Konjunktur weniger als die meisten – die Leute brauchen es auch in schweren Zeiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Moins sensible à l’économie que la plupart — les gens en ont toujours besoin dans les moments difficiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Risente dell’economia meno della maggior parte dei settori — le persone ne hanno comunque bisogno nei momenti difficili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 多くの業界より、景気の影響を受けにくいです。苦しい時期でも、人びとに必要とされます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Відчуває економіку слабше за більшість — у важкі часи люди все одно в цьому потребують."
          }
        }
      }
    },
    "📊 Feels the economy more than most — when money is tight, people cut back on this first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Spürt die Konjunktur stärker als die meisten – wenn das Geld knapp ist, sparen die Leute hier zuerst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Plus sensible à l’économie que la plupart — quand l’argent se fait rare, c’est là que les gens réduisent d’abord leurs dépenses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "📊 Risente dell’economia più della maggior parte dei settori — quando i soldi scarseggiano, la gente taglia prima su questo."
