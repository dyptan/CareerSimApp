            "state" : "translated",
            "value" : "Ottieni %@. È il passo più lungo, quindi inizia presto."
          }
        }
      }
    },
    "Get a spot on a TV show and let everyone see you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ergattere einen Platz in einer TV-Show und lass dich von allen sehen."
