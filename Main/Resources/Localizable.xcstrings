    "Openings, tactics, endgames. The classic contest of pure calculation and nerve over the board." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eröffnungen, Taktik, Endspiele. Der klassische Wettstreit aus purem Rechnen und Nervenstärke am Brett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperture, tattiche, finali. La classica sfida di puro calcolo e nervi saldi sulla scacchiera."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дебюти, тактика, ендшпілі. Класичне змагання чистого розрахунку та витримки за шахівницею."
          }
        }
      }
    },
    "Organising your days and finishing things on time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Tage organisieren und Dinge pünktlich fertig bekommen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organizzare le tue giornate e finire le cose in tempo."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Організовувати свої дні й завершувати справи вчасно."
          }
        }
      }
    },
