    "Specialty board certification earned after residency — the standard credential for attending physicians and medical leadership. Verifies mastery of a medical specialty." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Facharzt-Zertifizierung, die du nach der Facharztausbildung erwirbst – der Standardnachweis für Fachärzte und die medizinische Leitung. Sie bestätigt, dass du ein medizinisches Fachgebiet meisterhaft beherrschst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificazione di specialità conseguita dopo la specializzazione medica — la qualifica standard per i medici strutturati e per la direzione sanitaria. Attesta la padronanza di una specialità medica."
          }
        }
      }
    },
    "Spelling Bee" : {
