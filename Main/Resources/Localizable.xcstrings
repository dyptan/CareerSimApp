    "Lets you fly planes for paid work — required to be hired by airlines and freight carriers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit darfst du gegen Bezahlung Flugzeuge fliegen – nötig, um von Fluggesellschaften und Frachtunternehmen eingestellt zu werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te permet de piloter des avions pour un travail rémunéré — exigée par les compagnies aériennes et les transporteurs de fret."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti permette di pilotare aerei per lavoro — necessario per farsi assumere da compagnie aeree e vettori cargo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事として飛行機を操縦できる免許です。航空会社や貨物航空会社に採用されるために必要です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дозволяє літати на літаках за плату — потрібна, щоб влаштуватися до авіакомпаній і вантажних перевізників."
          }
        }
      }
    },
    "Licences" : {
      "localizations" : {
