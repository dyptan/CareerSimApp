    "Karate, judo, boxing — disciplines that drill technique, respect, and grit through repetition." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karate, Judo, Boxen – Disziplinen, die durch Wiederholung Technik, Respekt und Durchhaltevermögen schulen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karaté, judo, boxe — des disciplines qui travaillent la technique, le respect et la ténacité par la répétition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Karate, judo, boxe — discipline che allenano tecnica, rispetto e grinta attraverso la ripetizione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空手、柔道、ボクシングなど。くり返しの練習で、技術、敬意、粘り強さを身につけます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карате, дзюдо, бокс — дисципліни, що через повторення виробляють техніку, повагу й завзятість."
          }
        }
      }
    },
