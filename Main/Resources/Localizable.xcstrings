    "Explore how the world works with experiments." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entdecke mit Experimenten, wie die Welt funktioniert."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvre comment le monde fonctionne grâce aux expériences."
          }
        },
        "it" : {
          "stringUnit" : {
