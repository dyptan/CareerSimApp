    "EPA 608" : {
      "comment" : "Training: US EPA Section 608 certification for handling refrigerants. Proper name, US-specific.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EPA 608"
          }
        },
