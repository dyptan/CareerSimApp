    "Only %@ of applicants who are otherwise ideal get the seat each year." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tra i candidati altrimenti ideali, ottiene il posto ogni anno solo %@."
