    "Take the lead in a big movie." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele die Hauptrolle in einem großen Kinofilm."
          }
        },
        "fr" : {
          "stringUnit" : {
