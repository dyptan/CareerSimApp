    "Sports careers end early in the game too." : {
      "comment" : "Professional athlete note, point 2: what the Simplified tutorial mode does instead",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche nel gioco le carriere sportive finiscono presto."
          }
        }
      }
    },
    "Stand out" : {
      "comment" : "Title of the second advisor card about a hard-to-reach job: making the application strong",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distinguiti"
          }
        }
      }
    },
    "Standard" : {
      "comment" : "Seniority level of the plain version of a job, with no Junior/Senior/Lead prefix\nThe seniority of a job that is the plain role with no Senior, Lead or Junior in front. Next to labels like Senior and Lead.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        },
        "it" : {
          "stringUnit" : {
