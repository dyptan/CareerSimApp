    },
    "Make your pitch to the class, then count the votes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deine Rede vor der Klasse, dann werden die Stimmen gezählt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fais ton pitch devant la classe, puis compte les voix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai il tuo discorso alla classe, poi conta i voti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
