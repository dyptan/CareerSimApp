          }
        }
      }
    },
    "Practise it again this year and you're entered automatically." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übe auch dieses Jahr, dann bist du automatisch dabei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pratique cette activité encore cette année et tu participes automatiquement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se continui anche quest’anno, partecipi in automatico."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今年も練習すれば、自動的に出場します。"
