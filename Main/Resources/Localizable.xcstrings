        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Досліджуй, як влаштований світ, за допомогою експериментів."
          }
        }
      }
    },
    "Extra maths beyond the lesson: puzzles, proofs, and problem sets that stretch you." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzliche Mathematik über den Unterricht hinaus: Rätsel, Beweise und Aufgabenserien, die dich fordern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des maths en plus du cours : énigmes, démonstrations et séries de problèmes qui te poussent plus loin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matematica extra oltre la lezione: rompicapi, dimostrazioni ed esercizi che ti mettono alla prova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授業を超えた数学です。パズルや証明、力がぐんと伸びる問題集に挑みます。"
          }
        },
        "uk" : {
          "stringUnit" : {
