    "%@ has one door: the “%@” title. Without it your chance stays at about %@, whatever else you do." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat nur eine Tür: den Titel „%2$@“. Ohne ihn bleibt deine Chance bei etwa %3$@, egal, was du sonst tust."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ has one door: the “%2$@” title. Without it your chance stays at about %3$@, whatever else you do."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour le poste « %1$@ », il n’y a qu’une porte : le titre « %2$@ ». Sans lui, tes chances restent d’environ %3$@, quoi que tu fasses d’autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ruolo di %1$@ ha una sola porta d’ingresso: il titolo «%2$@». Senza di esso la tua probabilità resta intorno a %3$@, qualunque altra cosa tu faccia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の入り口は1つだけ、「%2$@」の称号です。これがないと、ほかに何をしても確率は約%3$@のままです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У професії «%1$@» одні двері — титул «%2$@». Без нього твій шанс лишається на рівні близько %3$@ незалежно від усього іншого."
          }
        }
      }
    },
    "%@ higher than usual" : {
