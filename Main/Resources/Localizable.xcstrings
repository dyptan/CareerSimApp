    "Nothing new is open to you right now — look through the jobs list for something that catches your eye." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Im Moment steht dir nichts Neues offen – stöbere in den Jobs, ob dir etwas ins Auge fällt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien de nouveau ne s’ouvre à toi pour l’instant — parcours la liste des emplois pour trouver ce qui t’attire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ora non ti si apre niente di nuovo — dai un’occhiata all’elenco dei lavori e cerca qualcosa che ti colpisca."
