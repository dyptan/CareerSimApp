    "Adds +%@ to your chance for %@ jobs. Not open to you yet: %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringt +%1$@ Chance für Jobs in %2$@. Für dich noch nicht offen: %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds +%1$@ to your chance for %2$@ jobs. Not open to you yet: %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ajoute +%1$@ à tes chances pour les métiers en %2$@. Pas encore accessible : %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge +%1$@ alla tua probabilità per i lavori nel settore %2$@. Per ora non è disponibile per te: %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@の仕事で確率が+%1$@アップします。まだ受けられません。%3$@です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає +%1$@ до шансу на роботу у сфері «%2$@». Ще недоступно: %3$@."
          }
        }
      }
    },
    "Adds +%@ to your chance for %@ jobs. Not required — a credential that shows you're serious. One course counts; they don't stack." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bringt +%1$@ Chance für Jobs in %2$@. Nicht erforderlich – eine Qualifikation, die zeigt, dass du es ernst meinst. Es zählt nur ein Kurs; mehrere addieren sich nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Adds +%1$@ to your chance for %2$@ jobs. Not required — a credential that shows you're serious. One course counts; they don't stack."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle ajoute +%1$@ à tes chances pour les métiers en %2$@. Pas obligatoire — une qualification qui montre ton sérieux. Une seule formation compte ; elles ne se cumulent pas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge +%1$@ alla tua probabilità per i lavori nel settore %2$@. Non è obbligatorio — è una qualifica che dimostra che fai sul serio. Conta un solo corso; non si sommano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@の仕事で確率が+%1$@アップします。必須ではありませんが、本気度を示す資格です。数えられるのは1講座だけで、重ねても加算されません。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Додає +%1$@ до шансу на роботу у сфері «%2$@». Не обовʼязково — це кваліфікація, що показує серйозність твоїх намірів. Враховується один курс; вони не сумуються."
          }
        }
      }
    },
    "Adds ≈ +%@ to your chance a year, from %@." : {
      "localizations" : {
