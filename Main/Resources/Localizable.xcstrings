    "Collective agreements set the floor (Italy has no legal minimum wage)" : {
      "comment" : "Noun phrase naming the minimum-wage rule in Italy. It leads the picker line \"<this>: no job pays under <amount> a year.\"",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarifverträge legen die Untergrenze fest (Italien hat keinen gesetzlichen Mindestlohn)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les conventions collectives fixent le plancher (l’Italie n’a pas de salaire minimum légal)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I contratti collettivi fissano il minimo (l’Italia non ha un salario minimo per legge)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "労働協約で決まる下限（イタリアに法定の最低賃金はありません）"
          }
        },
        "uk" : {
