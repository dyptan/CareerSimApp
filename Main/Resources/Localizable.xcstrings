          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ in %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (%2$@)"
          }
        },
        "it" : {
          "stringUnit" : {
