        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Займайся цим і цього року — і тебе буде записано автоматично."
          }
        }
      }
    },
    "Practise what the job needs" : {
      "comment" : "Title of an advisor card: last year's activities did not build the skills the goal role asks for",
      "localizations" : {
