    },
    "Ages 7+ · easiest" : {
      "comment" : "Audience chip on the Simplified game-mode card: the youngest players, the gentlest mode.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab 7 Jahren · am einfachsten"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da 7 anni · il più facile"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7歳以上 · いちばんかんたん"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від 7 років · найлегший"
          }
        }
      }
    },
    "Ages 7+ · easiest. The gentlest way in — a good first game." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab 7 Jahren · am einfachsten. Der sanfteste Einstieg – ein gutes erstes Spiel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da 7 anni · il più facile. Il modo più dolce per iniziare — un ottimo primo gioco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7歳以上 · いちばんかんたん。いちばんやさしい入り口で、はじめてのゲームにぴったりです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Від 7 років · найлегший. Найлагідніший початок — гарна перша гра."
          }
        }
      }
    },
    "Ages roughly 11–13. Subjects branch out into science, history, languages, and the arts." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 11–13 Jahre. Die Fächer werden vielfältiger: Naturwissenschaften, Geschichte, Sprachen und Kunst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dagli 11 ai 13 anni circa. Le materie si ampliano: scienze, storia, lingue e arti."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приблизно 11–13 років. Предмети розгалужуються: природничі науки, історія, мови та мистецтво."
          }
        }
      }
    },
    "Ages roughly 14–17. A diploma is needed for most jobs and to apply to college or vocational programmes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 14–17 Jahre. Für die meisten Jobs brauchst du einen Schulabschluss, ebenso für die Bewerbung an einer Hochschule oder in beruflichen Programmen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai 14 ai 17 anni circa. Il diploma serve per la maggior parte dei lavori e per candidarsi all’università o ai corsi professionali."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приблизно 14–17 років. Диплом про закінчення школи потрібен для більшості робіт і для вступу до коледжу чи на фахові програми."
          }
        }
      }
    },
    "Ages roughly 6–10. Reading, writing, basic math — the foundation everything else builds on." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Etwa 6–10 Jahre. Lesen, Schreiben, Grundrechnen – das Fundament, auf dem alles andere aufbaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai 6 ai 10 anni circa. Lettura, scrittura e matematica di base — le fondamenta su cui si costruisce tutto il resto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приблизно 6–10 років. Читання, письмо, основи математики — фундамент, на якому тримається все інше."
          }
        }
      }
    },
    "Agriculture" : {
      "comment" : "A field of work (job category): farming and growing food.\nField of study (degree subject): farming and food production.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
