        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚀 Apre sempre. Probabilità di superare il primo anno: %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚀 事業は必ず開けます。1年目を乗り切れる確率は%@です。"
