    "Five-a-side basketball. Fast-paced team sport rewarding agility, teamwork, and split-second decisions." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basketball, fünf gegen fünf. Ein rasanter Teamsport, der Beweglichkeit, Zusammenspiel und Entscheidungen in Sekundenbruchteilen belohnt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basket-ball à cinq. Un sport collectif rapide qui récompense l’agilité, l’esprit d’équipe et les décisions prises en une fraction de seconde."
          }
        },
        "it" : {
          "stringUnit" : {
