    "Skills are the things you're good at, besides school and work experience. They help with:" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fähigkeiten sind die Dinge, in denen du gut bist – neben Schule und Berufserfahrung. Sie helfen bei:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les compétences sont ce que tu sais bien faire, en plus des études et de l’expérience professionnelle. Elles servent à :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
