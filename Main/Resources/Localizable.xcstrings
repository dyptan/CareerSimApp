    },
    "🚀 Ventures: one of the two founder traits behind every venture's odds." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚀 Gründungen: eine der beiden Gründer-Eigenschaften hinter den Erfolgschancen jeder Gründung."
