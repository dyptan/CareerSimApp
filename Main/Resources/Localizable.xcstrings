        }
      }
    },
    "Only %@ of the people who qualify get a seat like this each year — however strong the application." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni anno la quota di chi ha i requisiti e ottiene un posto così è pari a %@ — per quanto forte sia la candidatura."
          }
        }
      }
    },
