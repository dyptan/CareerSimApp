    "Nobody is posting %@ jobs this year — the market changes every year, so check again next year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Jahr schreibt niemand Stellen als %@ aus – der Markt ändert sich jedes Jahr, schau also nächstes Jahr wieder nach."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune offre pour le poste « %@ » cette année — le marché change chaque année, alors reviens voir l’année prochaine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quest’anno nessuno pubblica annunci per il ruolo di %@ — il mercato cambia ogni anno, quindi ricontrolla l’anno prossimo."
