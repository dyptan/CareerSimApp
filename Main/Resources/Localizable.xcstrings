    "Ballet, hip-hop, ballroom — technique drilled until it looks effortless, then performed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ballett, Hip-Hop, Gesellschaftstanz – Technik, die so lange geübt wird, bis sie mühelos aussieht, und dann aufgeführt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ballet, hip-hop, danse de salon — une technique travaillée jusqu’à paraître sans effort, puis présentée sur scène."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danza classica, hip-hop, danze da sala — tecnica allenata finché sembra senza sforzo, e poi portata in scena."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バレエ、ヒップホップ、社交ダンス。らくらくとこなしているように見えるまで技術をくり返し練習し、そして披露します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балет, хіп-хоп, бальні танці — техніка, яку відточують, доки вона не виглядатиме легко, а потім виконують на публіці."
          }
        }
      }
    },
    "Banked a year of %@ experience running %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Jahr Erfahrung in %1$@ gesammelt – Projekt: %2$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Banked a year of %1$@ experience running %2$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une année d’expérience en %1$@ ajoutée grâce au projet « %2$@ »"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un anno di esperienza nel settore %1$@, portando avanti «%2$@»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
