    "🤔 I haven't decided yet" : {
      "comment" : "Advisor chat, quick-reply chip: the player does not know yet what job they want",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Ich weiß es noch nicht"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Je n’ai pas encore décidé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Non ho ancora deciso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 まだ決めていません"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Ще не знаю"
          }
        }
      }
    },
    "🤔 Not sure yet? It suggests things to try, and after a few moves it names jobs that fit the skills you've built." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Noch unsicher? Er schlägt dir Dinge zum Ausprobieren vor und nennt dir nach ein paar Schritten Jobs, die zu den Fähigkeiten passen, die du aufgebaut hast."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Tu hésites encore ? Il te propose des choses à essayer, et après quelques choix il te cite des métiers qui correspondent aux compétences que tu as développées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Non hai ancora le idee chiare? Ti suggerisce cose da provare e, dopo qualche mossa, indica i lavori adatti alle competenze che hai sviluppato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 まだ決まっていませんか？試してみることを提案し、何回か挑戦したあとは、身につけたスキルに合う仕事を教えてくれます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤔 Ще не знаєш, що обрати? Радник підкаже, що спробувати, а після кількох спроб назве роботи, які пасують до твоїх навичок."
          }
        }
      }
    },
    "🤝 Nobody bought at that price this year. Ask for less, or try again next year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤝 Zu diesem Preis hat dieses Jahr niemand gekauft. Verlange weniger oder versuch es nächstes Jahr noch einmal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🤝 Personne n’a acheté à ce prix cette année. Demande moins, ou réessaie l’année prochaine."
