          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Один хід = один рік"
          }
        }
      }
    },
    "One word at a time, on stage, until one speller is left." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wort für Wort auf der Bühne, bis nur noch ein Teilnehmer übrig ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un mot après l’autre, sur scène, jusqu’à ce qu’il ne reste qu’un seul concurrent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parola alla volta, sul palco, finché non rimane un solo concorrente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ステージで1語ずつつづり、最後の1人になるまで続きます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По одному слову на сцені, поки не залишиться лише один учасник."
          }
        }
      }
    },
