    },
    "Having a hard time. Some jobs disappear, pay stops growing, and more people lose their jobs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Krise. Manche Jobs verschwinden, die Bezahlung steigt nicht mehr und mehr Menschen verlieren ihren Job."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In difficoltà. Alcuni lavori spariscono, gli stipendi smettono di crescere e più persone perdono il posto."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скрутний час. Деякі посади зникають, зарплати перестають зростати, а ще більше людей втрачають роботу."
          }
        }
      }
    },
