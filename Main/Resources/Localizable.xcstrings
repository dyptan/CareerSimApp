    "Only %@ of applicants who are otherwise ideal get the seat each year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Jahr bekommen nur %@ der sonst idealen Bewerber den Posten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls %@ des candidats par ailleurs idéaux obtiennent la place chaque année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni anno ottiene il posto solo una piccola parte dei candidati altrimenti ideali (%@)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほかの条件が理想的な応募者でも、毎年ポストを得られるのは%@だけです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Крісло щороку отримують лише %@ заявників, які в усьому іншому ідеальні."
          }
        }
      }
    },
    "Only %@ of the people who qualify get a seat like this each year — however strong the application." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur %@ der Qualifizierten bekommen jedes Jahr einen solchen Posten – egal, wie stark die Bewerbung ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls %@ des personnes qui remplissent les conditions décrochent une telle place chaque année — quelle que soit la force de la candidature."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni anno ottiene un posto così solo una piccola parte di chi ha i requisiti (%@) — per quanto forte sia la candidatura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このようなポストを得られるのは、条件を満たした人のうち毎年%@だけです。応募がどれだけ強力でも変わりません。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Таке крісло щороку отримують лише %@ людей, які відповідають вимогам, — хоч би яка сильна була заявка."
          }
        }
      }
    },
