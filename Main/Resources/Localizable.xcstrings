    "FAA Airframe & Powerplant certificate. Only a certificated mechanic may sign an aircraft back into service." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das A&P-Zertifikat (Airframe & Powerplant) der FAA. Nur ein zertifizierter Mechaniker darf ein Flugzeug wieder für den Betrieb freigeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificat A&P de la FAA (mécanicien aéronautique). Seul un mécanicien certifié peut signer la remise en service d’un avion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attestato FAA Airframe & Powerplant. Solo un meccanico certificato può firmare il rientro in servizio di un aeromobile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A&P整備士資格（FAAの機体・エンジン整備資格）です。資格を持つ整備士だけが、整備した航空機を運航に戻す署名ができます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертифікат FAA A&P (планер і силова установка). Лише сертифікований механік може своїм підписом повернути літак в експлуатацію."
          }
        }
      }
    },
    "FAA-issued certificate proving you can keep passengers safe on commercial flights." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von der FAA ausgestelltes Zertifikat, das beweist, dass du auf kommerziellen Flügen für die Sicherheit der Passagiere sorgen kannst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificat délivré par la FAA qui prouve que tu peux assurer la sécurité des passagers sur les vols commerciaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attestato rilasciato dalla FAA che dimostra che sai garantire la sicurezza dei passeggeri sui voli commerciali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FAA（米国連邦航空局）が発行する、旅客機で乗客の安全を守れることを証明する資格です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертифікат, виданий FAA, що підтверджує: ти можеш забезпечити безпеку пасажирів на комерційних рейсах."
          }
        }
      }
    },
