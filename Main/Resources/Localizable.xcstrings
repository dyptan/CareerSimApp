    "Curious about the %@ job? It pays %@ a year and needs %@ %lld. You're at %lld — keep practising!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neugierig auf den Job als %1$@? Er zahlt %2$@ pro Jahr und verlangt bei der Fähigkeit „%3$@“ den Wert %4$lld. Du bist bei %5$lld – übe weiter!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Curious about the %1$@ job? It pays %2$@ a year and needs %3$@ %4$lld. You're at %5$lld — keep practising!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le poste « %1$@ » t’intrigue ? Il paie %2$@ par an et demande %3$@ : %4$lld. Tu es à %5$lld — continue à pratiquer !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti incuriosisce il ruolo di %1$@? Paga %2$@ all’anno e richiede la competenza %3$@ a quota %4$lld. Tu sei a %5$lld — continua a esercitarti!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の仕事が気になりますか？年収は%2$@で、%3$@が%4$lld必要です。いまは%5$lldです。練習を続けましょう！"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цікавить робота «%1$@»? Платять %2$@ на рік, а потрібна навичка «%3$@» на рівні %4$lld. У тебе — %5$lld. Продовжуй тренуватися!"
          }
        }
      }
    },
