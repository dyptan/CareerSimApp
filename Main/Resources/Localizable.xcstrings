    "Investment round for %@ fell through" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finanzierungsrunde für „%@“ ist gescheitert"
          }
        },
        "fr" : {
          "stringUnit" : {
