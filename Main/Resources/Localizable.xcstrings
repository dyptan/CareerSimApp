          "stringUnit" : {
            "state" : "translated",
            "value" : "Перукарі, масажисти й тренери демонструють свою майстерність."
          }
        }
      }
    },
    "Hands-on training (1–3 years) for a specific trade — like welding, plumbing, nursing assistant, or electrician work. Faster and cheaper than a Bachelor’s." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praxisnahe Ausbildung (1–3 Jahre) für ein bestimmtes Handwerk – etwa Schweißen, Klempnerei, Pflegehilfe oder Elektrikerarbeit. Schneller und günstiger als ein Bachelor-Abschluss."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Formazione pratica (1–3 anni) per un mestiere specifico — come saldatura, idraulica, assistenza infermieristica o lavori da elettricista. Più rapida ed economica di una laurea triennale."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практична підготовка (1–3 роки) до конкретної робітничої професії — зварювальника, сантехніка, молодшої медсестри чи електрика. Швидше й дешевше, ніж ступінь бакалавра."
          }
        }
      }
    },
    "Hands-on work — building, fixing, driving, growing, cooking." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Praktische Arbeit – bauen, reparieren, fahren, anbauen, kochen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lavoro sul campo — costruire, riparare, guidare, coltivare, cucinare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Практична робота — будівництво, ремонт, водіння, вирощування, куховарство."
          }
        }
      }
    },
    "Hard requirements not met" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
