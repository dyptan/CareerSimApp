    "Make products from raw materials: factories, workshops, and artisans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produkte aus Rohstoffen herstellen: Fabriken, Werkstätten und Handwerker."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fabriquer des produits à partir de matières premières : usines, ateliers et artisans."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produci beni a partire da materie prime: fabbriche, officine e artigiani."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "原材料から製品をつくります。工場、工房、職人の仕事です。"
