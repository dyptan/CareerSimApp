        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une affiche, une expérience et un juge, bloc-notes à la main."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un poster, un esperimento e un giudice con la cartellina in mano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポスター、実験、そしてクリップボードを手にした審査員です。"
