    "Professional Engineer" : {
      "comment" : "Training: Professional Engineer (PE) licence, a US state licence to sign off engineering plans.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional Engineer (PE)"
