    "%@. Tap the ⓘ next to your age at any time to check how you're doing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tippe jederzeit auf das ⓘ neben deinem Alter, um zu sehen, wie du dich schlägst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Appuie à tout moment sur le ⓘ à côté de ton âge pour voir où tu en es."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Tocca ⓘ accanto alla tua età in qualsiasi momento per vedere come stai andando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@。年齢の横のⓘをタップすると、いつでも進み具合を確認できます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@. Торкнись ⓘ біля свого віку в будь-який момент, щоб перевірити, як у тебе справи."
          }
        }
      }
    },
