    "26.2 miles against thousands. A few seasons of training under your belt to even finish." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "42,2 km gegen Tausende. Ein paar Trainingssaisons brauchst du schon, um überhaupt anzukommen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "42,195 km face à des milliers de coureurs. Il faut quelques saisons d’entraînement rien que pour terminer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "42,2 km contro migliaia di partecipanti. Servono alcune stagioni di allenamento anche solo per arrivare al traguardo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数千人と競う26.2マイル。完走するだけでも、数シーズンのトレーニングが必要です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "42,2 км у змаганні з тисячами інших. Щоб навіть фінішувати, потрібно кілька сезонів тренувань за плечима."
          }
        }
      }
    },
    "5K Race Winner" : {
      "localizations" : {
