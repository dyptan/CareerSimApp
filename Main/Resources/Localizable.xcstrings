    "Founded %@ — you're now CEO" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ gegründet – du bist jetzt CEO"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu as fondé l’entreprise « %@ » et tu es maintenant PDG"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impresa fondata: %@ — ora sei CEO"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を創業し、CEOになりました"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Засновано бізнес «%@»: тепер ти генеральний директор (CEO)"
          }
        }
      }
    },
    "Founder of %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gründer von %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondateur : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fondatore di %@"
          }
        },
        "ja" : {
