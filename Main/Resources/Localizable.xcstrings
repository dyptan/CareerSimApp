          }
        }
      }
    },
    "Sketching, painting, and composition. Patient hands and a trained eye, built one piece at a time." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skizzieren, Malen und Bildaufbau. Geduldige Hände und ein geschultes Auge, Werk für Werk aufgebaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schizzi, pittura e composizione. Mani pazienti e un occhio allenato, costruiti un’opera alla volta."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начерки, живопис і композиція. Терплячі руки й натреноване око, що формуються роботою за роботою."
          }
        }
      }
    },
    "Skill" : {
      "comment" : "Fallback name for a soft skill that has no label\nFallback name of a soft skill",
      "localizations" : {
        "de" : {
          "stringUnit" : {
