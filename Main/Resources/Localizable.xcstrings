    "Working directly with people — serving, teaching, caring, performing." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arbeit mit Menschen – bedienen, unterrichten, pflegen, auftreten."
