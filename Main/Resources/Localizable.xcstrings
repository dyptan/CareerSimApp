    "Your chances fell" : {
      "comment" : "Title of an advisor card: the player's hire odds for the goal role dropped since the last review",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Chancen sind gesunken"
          }
        },
