    "No job means no pay. Open Jobs to apply for one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Job bedeutet kein Gehalt. Öffne Jobs, um dich auf einen zu bewerben."
