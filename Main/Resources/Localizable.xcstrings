    "Grow food and care for plants and animals." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baue Essen an und kümmere dich um Pflanzen und Tiere."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Produis de la nourriture et prends soin des plantes et des animaux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coltiva il cibo e prenditi cura di piante e animali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "食べ物を育て、植物や動物の世話をします。"
