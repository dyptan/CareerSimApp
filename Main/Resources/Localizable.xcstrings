          "stringUnit" : {
            "state" : "translated",
            "value" : "Le università lo guardano quando ti candidi — quelle migliori gli danno molta importanza."
          }
        }
      }
    },
    "University" : {
      "comment" : "School term: mainstream university tier (Canada, United Kingdom, Ukraine, Australia).",
      "localizations" : {
        "de" : {
