    "Tuition is moderate, and the federal part of a student loan is interest-free." : {
      "comment" : "Info bullet in the country picker describing Canada's pay and school costs.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Studiengebühren sind moderat, und der Bundesanteil eines Studienkredits ist zinsfrei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les frais de scolarité sont modérés, et la part fédérale du prêt étudiant est sans intérêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tasse d’iscrizione sono moderate, e la parte federale di un prestito studentesco è senza interessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授業料はほどほどで、奨学金のうち連邦政府の分は無利子です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Плата за навчання помірна, а федеральна частина студентського кредиту — без відсотків."
          }
        }
      }
    },
    "Tuition: %@ against %@ a year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Studiengebühren: %1$@ gegenüber %2$@ pro Jahr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tuition: %1$@ against %2$@ a year."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frais de scolarité : %1$@ contre %2$@ par an."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tasse d’iscrizione: %1$@ contro %2$@ all’anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授業料：1年あたり%1$@（トップ校）に対して%2$@（一般的な学校）。"
          }
        },
        "uk" : {
          "stringUnit" : {
