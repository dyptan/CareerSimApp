    "Certified Nursing Assistant. The first step into nursing — basic patient care under a nurse’s supervision." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zertifizierter Pflegehelfer. Der erste Schritt in die Pflege – grundlegende Patientenversorgung unter Aufsicht einer Pflegekraft."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assistente infermieristico certificato. Il primo passo verso l’infermieristica — assistenza di base ai pazienti sotto la supervisione di un infermiere."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертифікована молодша медсестра. Перший крок у сестринську справу — базовий догляд за пацієнтами під наглядом медсестри."
          }
        }
      }
    },
    "Certified Public Accountant — the licence required to sign off on tax filings, audit financial statements, and lead corporate finance roles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certified Public Accountant (CPA, US-Wirtschaftsprüfer-Lizenz) – nötig, um Steuererklärungen abzuzeichnen, Jahresabschlüsse zu prüfen und Führungsrollen im Finanzwesen von Unternehmen zu übernehmen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commercialista (CPA) — l’abilitazione necessaria per firmare le dichiarazioni dei redditi, revisionare i bilanci e guidare i ruoli della finanza aziendale."
          }
        }
      }
    },
    "Certified to prepare and dispense prescriptions under a pharmacist’s supervision — the way into a pharmacy without the doctorate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zertifiziert, Rezepte unter Aufsicht eines Apothekers vorzubereiten und abzugeben – der Weg in die Apotheke ohne Promotion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certificazione per preparare e dispensare le prescrizioni sotto la supervisione di un farmacista — la strada per lavorare in farmacia senza il dottorato."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сертифікація на право готувати й відпускати ліки за рецептами під наглядом фармацевта — шлях в аптеку без докторського ступеня."
          }
        }
      }
    },
