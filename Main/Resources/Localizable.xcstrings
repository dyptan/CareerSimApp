          }
        }
      }
    },
    "%@ would be a loan that grows %@ a year — you pay it back even if the business closes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wären ein Kredit, der pro Jahr um %2$@ wächst – du zahlst ihn auch zurück, wenn das Unternehmen schließt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ would be a loan that grows %2$@ a year — you pay it back even if the business closes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu emprunterais %1$@ : le prêt augmente de %2$@ par an, et tu le rembourses même si l’entreprise ferme."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il prestito sarebbe di %1$@ e cresce ogni anno (interesse: %2$@) — lo restituisci anche se l’impresa chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "出資額のうち%1$@は借入になります。借入は1年あたり%2$@ずつ増え、事業が終わっても返済が必要です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ — це кредит на бізнес: він зростає на %2$@ на рік, і його треба повернути, навіть якщо бізнес закриється."
          }
        }
      }
    },
