    "Try a couple more different things, so I can see what you like." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probiere noch ein paar verschiedene Dinge aus, damit ich sehen kann, was dir gefällt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essaie encore deux ou trois choses différentes, pour que je voie ce qui te plaît."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prova ancora un paio di cose diverse, così posso capire cosa ti piace."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好きなことが分かるように、あと少しちがうことも試してみましょう。"
