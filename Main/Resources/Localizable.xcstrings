    },
    "No jobs match these filters. Try another kind of work, or turn off \"Only roles I qualify for\"." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keine Jobs passen zu diesen Filtern. Probiere eine andere Art von Arbeit aus oder schalte „Nur passende Positionen“ aus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun poste ne correspond à ces filtres. Essaie un autre type de travail, ou désactive « Seulement les postes accessibles »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessun lavoro corrisponde a questi filtri. Prova un altro tipo di lavoro oppure disattiva «Solo i ruoli per cui ho i requisiti»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この条件に合う仕事はありません。別の仕事の種類を選ぶか、「条件を満たす職種だけ」をオフにしてみましょう。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Жодна робота не відповідає цим фільтрам. Спробуй інший вид роботи або вимкни перемикач «Лише посади, що тобі підходять»."
          }
        }
      }
    },
