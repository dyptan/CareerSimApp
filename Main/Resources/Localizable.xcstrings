    "Professional Engineer (PE) — state licence required to sign off on engineering plans for buildings, bridges, and public works. Needed for senior civil, mechanical, and electrical engineering roles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional Engineer (PE) – eine staatliche Lizenz, um Baupläne für Gebäude, Brücken und öffentliche Bauten abzuzeichnen. Nötig für leitende Rollen im Bauingenieurwesen, im Maschinenbau und in der Elektrotechnik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingegnere abilitato (PE) — abilitazione statale necessaria per firmare i progetti di edifici, ponti e opere pubbliche. Serve per i ruoli senior di ingegneria civile, meccanica ed elettrica."
          }
        }
      }
    },
