    "Arguing a case against the clock — research it, build it, and persuade a room." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einen Standpunkt gegen die Uhr vertreten – recherchieren, aufbauen und einen ganzen Raum überzeugen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostenere una tesi contro il tempo — ricercala, costruiscila e convinci una sala."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відстоювання позиції на час: дослідь тему, збудуй аргументацію та переконай аудиторію."
          }
        }
      }
    },
    "Art Contest Winner" : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincitore del concorso d’arte"
          }
        }
      }
    },
    "Arts" : {
      "comment" : "A field of fame: the creative arts - painting, design, writing, language. Plural noun, not the school subject.\nField of study (degree subject): visual, performing and creative arts (music, drawing, acting, cooking).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunst"
          }
        },
        "it" : {
          "stringUnit" : {
