            "value" : "Guardati crescere"
          }
        }
      }
    },
    "Welcome and care for guests in hotels, restaurants, flights, and events to make their day great." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gäste in Hotels, Restaurants, Flugzeugen und bei Events begrüßen und umsorgen, damit ihr Tag großartig wird."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accogli gli ospiti e prenditi cura di loro in alberghi, ristoranti, voli ed eventi per rendere speciale la loro giornata."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зустрічай гостей і дбай про них у готелях, ресторанах, на рейсах і заходах, щоб їхній день був чудовим."
          }
        }
      }
    },
    "Welcome to Career Sim! 👋" : {
