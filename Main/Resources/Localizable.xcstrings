    "Mind" : {
      "comment" : "Kind of contest: a contest of the mind such as chess or debate",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denksport"
          }
        },
        "fr" : {
