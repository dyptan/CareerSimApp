    "💵 It pays %@, then %@ of its %@ in the first two years, then the full amount — more in good years, less in bad ones." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💵 In den ersten beiden Jahren zahlt es nur einen Teil des vollen Betrags von %3$@ (zuerst %1$@, dann %2$@), danach den ganzen Betrag – mehr in guten Jahren, weniger in schlechten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "💵 It pays %1$@, then %2$@ of its %3$@ in the first two years, then the full amount — more in good years, less in bad ones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💵 Les deux premières années, elle rapporte %1$@ puis %2$@ de ses %3$@, ensuite le montant complet — plus dans les bonnes années, moins dans les mauvaises."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💵 Nei primi due anni paga solo una parte dell’importo pieno di %3$@ (primo anno: %1$@, secondo anno: %2$@), poi l’importo pieno — di più negli anni buoni, di meno in quelli difficili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💵 収入は満額（%3$@）に対して、1年目が%1$@、2年目が%2$@、3年目からは満額です。景気のよい年は収入が増え、悪い年は減ります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "💵 Платить %1$@, а потім %2$@ від %3$@ за перші два роки, далі — повну суму: більше в добрі роки, менше в погані."
          }
        }
      }
    },
