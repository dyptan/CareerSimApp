            "value" : "Ecco a che punto sei."
          }
        }
      }
    },
    "Hi, I'm your career advisor! 👋 Do you already have a job in mind that you'd like to work toward — or haven't you decided yet? Either answer is fine." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
