    "Openings, tactics, endgames. The classic contest of pure calculation and nerve over the board." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eröffnungen, Taktik, Endspiele. Der Klassiker unter den Wettbewerben: pures Rechnen und Nervenstärke am Brett."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvertures, tactique, finales. Le duel classique de calcul pur et de sang-froid autour de l’échiquier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aperture, tattiche, finali. La classica sfida di puro calcolo e nervi saldi sulla scacchiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オープニング、戦術、エンドゲーム。盤の上で、読みの深さと度胸を競う昔ながらの勝負です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дебюти, тактика, ендшпілі. Класичне змагання чистого розрахунку та витримки за шахівницею."
          }
        }
      }
    },
    "Organising your days and finishing things on time." : {
