    "%@ fame" : {
      "comment" : "Name of a lever in the career advisor. The argument is a field of fame, e.g. 'Science' or 'Entertainment'; 'fame' is the game's own term for public reputation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruhm in %@"
          }
        },
        "fr" : {
          "stringUnit" : {
