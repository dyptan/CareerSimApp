    },
    "A podcast you record and put out episode by episode. Build a loyal audience and your voice becomes a name people know." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Podcast, den du aufnimmst und Folge für Folge veröffentlichst. Gewinne ein treues Publikum, und deine Stimme wird zu einem Namen, den alle kennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un podcast que tu enregistres et publies épisode après épisode. Fidélise un public et ta voix devient un nom que les gens connaissent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un podcast che registri e pubblichi episodio dopo episodio. Costruisci un pubblico fedele e la tua voce diventa un nome conosciuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "収録して、1話ずつ配信するポッドキャストです。熱心なリスナーを増やせば、自分の声が人に知られる名前になります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подкаст, який ти записуєш і випускаєш епізод за епізодом. Збери вірну аудиторію — і твій голос стане імʼям, яке знають люди."
          }
        }
      }
    },
    "A portfolio of six, judged by working photographers." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
