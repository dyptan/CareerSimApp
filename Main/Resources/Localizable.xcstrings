      }
    },
    "🚫 Investors said no this time. Grow your reputation and try again next year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🚫 Die Investoren haben diesmal abgelehnt. Bau dir einen besseren Ruf auf und versuch es nächstes Jahr noch einmal."
          }
        },
