          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier sind die Jobs in %@. Welcher passt zu dir?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voici les métiers du domaine « %@ ». Lequel te ressemble ?"
          }
        },
        "it" : {
          "stringUnit" : {
