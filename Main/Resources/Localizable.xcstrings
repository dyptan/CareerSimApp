    "Office managers and assistants share how to keep a workplace running." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Büroleiter und Assistenten teilen, wie ein Arbeitsplatz am Laufen bleibt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
