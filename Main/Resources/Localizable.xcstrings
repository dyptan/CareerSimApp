            }
          }
        }
      }
    },
    "Without it your chance stays at %@ whatever your skills. Holding it adds +%@ and opens the door." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Without it your chance stays at %1$@ whatever your skills. Holding it adds +%2$@ and opens the door."
          }
