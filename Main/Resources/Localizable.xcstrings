          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un portfolio di sei foto, giudicato da fotografi professionisti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "6枚の作品集を、現役のカメラマンが審査します。"
