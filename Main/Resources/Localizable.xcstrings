            "value" : "道を開く称号を獲得する"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здобути титул, що відчиняє двері"
          }
        }
      }
    },
    "Win the seat" : {
      "comment" : "Title of the third advisor card about a hard-to-reach job: only a few qualified people get the scarce seat",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir den Posten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Décrocher la place"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conquista il posto"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポストを勝ち取る"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отримати крісло"
          }
        }
      }
    },
    "Win the “%@” title first. Only then do skills, fame and the rest count." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewinne zuerst den Titel „%@“. Erst dann zählen Fähigkeiten, Ruhm und der Rest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remporte d’abord le titre « %@ ». Ensuite seulement, les compétences, la renommée et le reste comptent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conquista prima il titolo «%@». Solo dopo contano competenze, fama e il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まず「%@」の称号を獲得しましょう。スキルや名声などが効いてくるのはそれからです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Спершу здобудь титул «%@». Лише тоді навички, слава та решта почнуть мати значення."
          }
        }
      }
    },
    "Win them with Activities: every year you practise, you enter that activity's biggest contest." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gewinne sie mit Aktivitäten: Jedes Jahr, in dem du übst, trittst du im größten Wettbewerb dieser Aktivität an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gagne-les avec les activités : chaque année où tu pratiques une activité, tu participes à sa plus grande compétition."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vincili con le attività: ogni anno in cui pratichi un’attività partecipi alla sua gara più importante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "賞や称号は活動で手に入れます。練習した年ごとに、その活動でいちばん大きなコンテストに出場します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вигравай їх через розділ «Заняття»: щороку, коли ти займаєшся, тебе записують на найбільше змагання цього заняття."
          }
        }
      }
    },
    "With less than %lld years, you can't apply yet." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mit weniger als einem Jahr kannst du dich noch nicht bewerben."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Mit weniger als %lld Jahren kannst du dich noch nicht bewerben."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "With less than %lld year, you can't apply yet."
                }
              },
              "other" : {
