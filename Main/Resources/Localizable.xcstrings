        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permis de conduire standard pour voiture (classe D). Nécessaire pour la plupart des postes qui demandent de conduire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patente di guida standard per auto (classe D). Serve per la maggior parte dei lavori che richiedono di guidare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "運転免許（普通）です。運転がかかわる仕事のほとんどで必要になります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Стандартне посвідчення водія легкового автомобіля (клас D). Потрібне для більшості робіт, повʼязаних із водінням."
          }
        }
      }
    },
    "Star in a Film" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hauptrolle in einem Film"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Être la vedette d’un film"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recita da protagonista in un film"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "映画の主演"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіграти головну роль у фільмі"
          }
        }
      }
    },
    "Star in a big movie. The more people know your name, the bigger the part — and a hit film makes you even more famous." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spiele die Hauptrolle in einem großen Kinofilm. Je mehr Leute deinen Namen kennen, desto größer die Rolle – und ein Hitfilm macht dich noch berühmter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joue dans un grand film. Plus les gens connaissent ton nom, plus le rôle est grand — et un film à succès te rend encore plus célèbre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recita da protagonista in un grande film. Più persone conoscono il tuo nome, più grande è la parte — e un film di successo accresce ancora di più la tua fama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大作映画で主演します。名前が知られているほど大きな役をもらえ、映画がヒットすればさらに有名になります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіграй у великому фільмі. Чим більше людей знає твоє імʼя, тим більша роль, а касовий хіт робить тебе ще відомішим."
          }
        }
      }
    },
    "Start here" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier starten"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commencer ici"
          }
        },
        "it" : {
