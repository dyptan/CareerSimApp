    "Ballet, hip-hop, ballroom — technique drilled until it looks effortless, then performed." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ballett, Hip-Hop, Gesellschaftstanz – Technik, die so lange geübt wird, bis sie mühelos aussieht, und dann aufgeführt wird."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Danza classica, hip-hop, danze da sala — tecnica allenata finché sembra senza sforzo, e poi portata in scena."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Балет, хіп-хоп, бальні танці — техніка, яку відточують, доки вона не виглядатиме легко, а потім виконують на публіці."
          }
        }
      }
    },
    "Banked a year of %@ experience running %@" : {
