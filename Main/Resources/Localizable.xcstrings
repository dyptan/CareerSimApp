    "Learn how to start, run, and grow a company." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lerne, ein Unternehmen zu gründen, zu führen und wachsen zu lassen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
