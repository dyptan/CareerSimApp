        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interpreta il ruolo principale in un grande film."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大作映画で主演します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зіграй головну роль у великому фільмі."
          }
        }
      }
    },
    "Take your songs on tour, from small clubs to stadiums." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh mit deinen Songs auf Tour – von kleinen Clubs bis in die Stadien."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emmène tes chansons en tournée, des petits clubs aux stades."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta le tue canzoni in tour, dai piccoli club agli stadi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の曲を持って、小さなライブハウスからスタジアムまでツアーに出ます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вирушай зі своїми піснями в тур — від маленьких клубів до стадіонів."
          }
        }
      }
    },
    "Take your songs on tour. A new act plays small clubs; a superstar fills stadiums — and every show grows your fame." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geh mit deinen Songs auf Tour. Eine neue Band spielt in kleinen Clubs; ein Superstar füllt Stadien – und jede Show mehrt deinen Ruhm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emmène tes chansons en tournée. Un nouvel artiste joue dans de petits clubs ; une superstar remplit des stades — et chaque concert fait grandir ta renommée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porta le tue canzoni in tour. Un nuovo artista suona nei piccoli club; una superstar riempie gli stadi — e ogni concerto accresce la tua fama."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の曲を持ってツアーに出ます。新人は小さなライブハウス、スーパースターはスタジアムを満員にします。公演のたびに名声が高まります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вирушай зі своїми піснями в тур. Початківці грають у маленьких клубах, суперзірка збирає стадіони, а кожен концерт примножує твою славу."
          }
        }
      }
    },
    "Taking part uses up your year." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teilnehmen verbraucht dein Jahr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Participer prend toute ton année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partecipare ti costa un anno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "参加すると、その1年を使います。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Участь забирає весь твій рік."
          }
        }
      }
    },
    "Talking, writing, listening and presenting — getting ideas across so people get them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprechen, schreiben, zuhören und präsentieren – Ideen so vermitteln, dass andere sie verstehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parler, écrire, écouter et présenter — faire passer des idées pour que les gens les comprennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parlare, scrivere, ascoltare e presentare — far arrivare le idee in modo che le persone le capiscano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話す、書く、聞く、発表する力。考えを相手にきちんと伝えます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Говорити, писати, слухати й виступати перед людьми — доносити ідеї так, щоб їх розуміли."
          }
        }
      }
    },
    "Teach and guide students to learn." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bring Schülern etwas bei und begleite sie beim Lernen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enseigne et guide les élèves pour qu’ils apprennent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insegna e guida gli studenti nell’apprendimento."
          }
