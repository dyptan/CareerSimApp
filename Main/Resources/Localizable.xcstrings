    "🏆 on a row means you practised it last year — tap it to see this year's contest and your chance to win." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steht ein 🏆 neben einer Aktivität, hast du sie letztes Jahr geübt – tippe darauf, um den Wettbewerb dieses Jahres und deine Siegchance zu sehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏆 sur une ligne signifie que tu as pratiqué cette activité l’année dernière — appuie dessus pour voir la compétition de cette année et tes chances de gagner."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il 🏆 accanto a un’attività significa che l’hai praticata l’anno scorso — toccalo per vedere la gara di quest’anno e la tua probabilità di vincere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行にある🏆は、去年その活動を練習したしるしです。タップすると、今年のコンテストと優勝確率が見られます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏆 у рядку позначає заняття, яке було в тебе минулого року — торкнись, щоб побачити змагання цього року та свій шанс перемогти."
          }
        }
      }
    },
    "🏗️ Your founder track record grew from %@ to %@ of %@ — the seat chance is now %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏗️ Deine Gründer-Erfolgsbilanz ist von %1$@ auf %2$@ von %3$@ gewachsen – die Chance auf den Posten liegt jetzt bei %4$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "🏗️ Your founder track record grew from %1$@ to %2$@ of %3$@ — the seat chance is now %4$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏗️ Ton parcours de fondateur est passé de %1$@ à %2$@ (sur %3$@) — tes chances d’obtenir la place sont maintenant de %4$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏗️ Il tuo curriculum da fondatore è passato da %1$@ a %2$@ su %3$@ — probabilità di ottenere il posto, ora: %4$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏗️ 起業実績が%1$@ポイントから%2$@ポイントに増えました（%3$@ポイント中）。ポストを得る確率は%4$@になりました。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🏗️ Здобутки засновника зросли з %1$@ до %2$@ (із %3$@ можливих) — шанс отримати крісло тепер %4$@."
          }
