    },
    "%@ didn't pan out — it was a %@ shot. You kept the practice: the skills it draws on improved anyway." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt „%1$@“ ist nicht aufgegangen – die Chance lag bei %2$@. Die Übung bleibt dir: Die Fähigkeiten, auf die es ankam, sind trotzdem besser geworden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ didn't pan out — it was a %2$@ shot. You kept the practice: the skills it draws on improved anyway."
