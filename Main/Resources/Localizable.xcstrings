        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimostrazioni, non calcoli — la fase nazionale per chi va a scuola."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算ではなく証明が問われる、生徒のための全国大会です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Докази, а не обчислення — національний тур для школярів."
          }
        }
      }
    },
    "Protect rights and follow rules: lawyers, judges, and helpers who know the law." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechte schützen und für die Einhaltung der Regeln sorgen: Anwälte, Richter und Helfer, die sich mit dem Recht auskennen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protéger les droits et respecter les règles : avocats, juges et aides qui connaissent la loi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proteggi i diritti e rispetta le regole: avvocati, giudici e assistenti che conoscono la legge."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人の権利を守り、ルールが守られるようにする仕事です。弁護士、裁判官、法律にくわしい助手などがいます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захищай права й стеж за дотриманням правил: юристи, судді та помічники, які знають закон."
          }
        }
      }
    },
