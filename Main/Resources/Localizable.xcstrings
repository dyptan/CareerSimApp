    "Climb the seasonal ranks from your own setup. Cheap to enter, a real grind." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steige von zu Hause aus durch die Saisonränge auf. Günstig zu starten, aber echte Schufterei."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grimpe dans le classement de la saison depuis ta propre installation. Inscription peu coûteuse, mais il faut vraiment s’accrocher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scala la classifica stagionale dalla tua postazione. Iscriversi costa poco, ma è una vera sfacchinata."
