            "state" : "translated",
            "value" : "Вечір пітчів для стартапів та інвесторів"
          }
        }
      }
    },
    "State University" : {
      "comment" : "Institution tier: a mainstream public university.\nSchool term: mainstream university tier (United States, India).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Universität"
          }
        },
        "it" : {
          "stringUnit" : {
