    "Spend the year writing and publishing a book." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbringe das Jahr damit, ein Buch zu schreiben und zu veröffentlichen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passe l’année à écrire et à publier un livre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passa l’anno a scrivere e a pubblicare un libro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1年かけて本を書き、出版します。"
