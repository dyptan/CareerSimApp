          }
        }
      }
    },
    "Professional Engineer (PE) — state licence required to sign off on engineering plans for buildings, bridges, and public works. Needed for senior civil, mechanical, and electrical engineering roles." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional Engineer (PE) – eine staatliche Lizenz, um Baupläne für Gebäude, Brücken und öffentliche Bauten abzuzeichnen. Nötig für leitende Rollen im Bauingenieurwesen, im Maschinenbau und in der Elektrotechnik."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Professional Engineer (PE, ingénieur professionnel) — licence d’État exigée pour valider les plans d’ingénierie des bâtiments, des ponts et des ouvrages publics. Nécessaire pour les postes d’ingénieur senior en génie civil, en mécanique et en électricité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingegnere abilitato (PE) — abilitazione statale necessaria per firmare i progetti di edifici, ponti e opere pubbliche. Serve per i ruoli senior di ingegneria civile, meccanica ed elettrica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "技術士（PE）：建物や橋、公共工事の設計図に署名するために必要な州の資格です。土木、機械、電気の上級エンジニア職で必要になります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ліцензований інженер (PE) — ліцензія штату, потрібна, щоб підписувати інженерні плани будівель, мостів і громадських споруд. Потрібна для старших посад в інженерії: будівельній, механічній та електричній."
          }
        }
      }
    },
