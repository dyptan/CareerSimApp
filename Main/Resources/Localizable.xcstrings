              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "La tua probabilità sale con le competenze qui sotto, i tuoi %1$lld anni di lavoro%2$@ e la fama nel settore %3$@ che hai già — avere fama in un settore rende più facile il progetto successivo in quel settore."
                }
              }
            }
