        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Створюй круті речі й розвʼязуй справжні проблеми."
          }
        }
      }
    },
    "Build homes, roads, and cities with tools, machines, and teamwork." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Werkzeugen, Maschinen und Teamarbeit Häuser, Straßen und Städte bauen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Construire des maisons, des routes et des villes avec des outils, des machines et du travail d’équipe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Costruisci case, strade e città con attrezzi, macchine e lavoro di squadra."
          }
