        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🔒 Si apre quando ottieni il titolo «%@» — inseguilo nella sezione Progetti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "🔒 「%@」の称号を手に入れると開きます。称号はプロジェクトで目指しましょう。"
