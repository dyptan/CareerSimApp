        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diesmal Absage bei „%@“ – du hast trotzdem Leute getroffen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ : réponse négative cette fois, mais tu as quand même élargi ton réseau"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’evento «%@» questa volta ti hanno detto di no — ma hai comunque incontrato persone"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今回は選ばれませんでしたが、足を運んで人と出会いました（%@）"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Захід «%@»: цього разу відмова, зате вдалося побувати там і познайомитися з людьми"
          }
        }
      }
    },
    "%@ starts at %@, which pays %@." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Job als %1$@ beginnt als %2$@ und zahlt %3$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ starts at %2$@, which pays %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le métier « %1$@ » démarre comme %2$@, un poste qui paie %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il ruolo di %1$@ parte da %2$@, che paga %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は%2$@から始まります。%3$@です。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Професія «%1$@» починається з посади «%2$@», де платять %3$@."
          }
        }
      }
    },
    "%@ title" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel „%@“"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titre : %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titolo «%@»"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@の称号"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Титул «%@»"
          }
        }
      }
    },
    "%@ took off: revenue tripled, and your stake is now worth many times more. Sell it in the Boardroom, or keep riding it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ ist durchgestartet: Der Umsatz hat sich verdreifacht und dein Anteil ist jetzt ein Vielfaches wert. Verkauf ihn in der Chefetage oder reite die Welle einfach weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’entreprise « %@ » a décollé : les revenus ont triplé et ta participation vaut maintenant plusieurs fois plus. Vends-la dans la Salle du conseil, ou continue de surfer sur la vague."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impresa «%@» è decollata: i ricavi sono triplicati e la tua quota ora vale molte volte di più. Vendila nella Sala del consiglio, oppure continua a cavalcare l’onda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が急成長しました。売上が3倍になり、持ち分の価値は何倍にもなっています。経営会議で売ることも、このまま持ち続けることもできます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бізнес «%@» злетів: виручка зросла втричі, а твоя частка тепер коштує в рази більше. Продай її в розділі «Правління» або тримай далі й їдь на хвилі успіху."
          }
        }
      }
    },
    "%@ worked out!" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt „%@“ ist aufgegangen!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le projet « %@ » a marché !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «%@» è andata bene!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がうまくいきました！"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» вдалося!"
          }
        }
      }
    },
    "%@ worked out! You earned the “%@” title." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekt „%1$@“ ist aufgegangen! Du hast den Titel „%2$@“ erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ worked out! You earned the “%2$@” title."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le projet « %1$@ » a marché ! Tu as obtenu le titre « %2$@ »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con «%1$@» è andata bene! Hai ottenuto il titolo «%2$@»."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@がうまくいきました！「%2$@」の称号を獲得しました。"
