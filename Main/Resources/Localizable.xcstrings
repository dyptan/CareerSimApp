    "• You keep all your pay. There's no rent, tuition or loans." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Du behältst dein ganzes Gehalt. Es gibt keine Miete, Studiengebühren oder Kredite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Tu gardes tout ton salaire. Il n’y a ni loyer, ni frais de scolarité, ni prêts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Tieni tutto lo stipendio. Non ci sono affitto, tasse d’iscrizione o prestiti."
