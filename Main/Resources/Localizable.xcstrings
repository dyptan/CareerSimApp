            "value" : "Arte e mente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アート＆頭脳"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Творчість і розум"
          }
        }
      }
    },
    "Ask for a salary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehaltswunsch nennen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander un salaire"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi uno stipendio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "希望給与を伝える"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Назвати зарплату"
          }
        }
      }
    },
    "Ask investors to put money into your company. If they say yes, the company grows — and so does your share of it. If they say no, you've spent the year trying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag Investoren, ob sie Geld in dein Unternehmen stecken. Sagen sie ja, wächst das Unternehmen – und dein Anteil daran wächst mit. Sagen sie nein, hat der Versuch dein Jahr verbraucht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à des investisseurs de mettre de l’argent dans ton entreprise. S’ils disent oui, l’entreprise grandit — et ta part aussi. S’ils disent non, tu as passé l’année à essayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi agli investitori di mettere denaro nella tua azienda. Se dicono di sì, l’azienda cresce — e cresce anche la tua quota. Se dicono di no, hai passato l’anno a provarci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投資家に会社へ出資してもらうようお願いします。承諾されれば会社が成長し、持ち分の価値も上がります。断られたら、その1年を挑戦に使ったことになります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попроси інвесторів вкласти гроші у твою компанію. Якщо вони погодяться, компанія зросте — а разом із нею і твоя частка. Якщо ні, цей рік піде на спроби."
          }
        }
      }
    },
    "Ask me anything…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mich etwas…"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pose-moi une question…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedimi quello che vuoi…"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "なんでも聞いてください…"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запитай мене про що завгодно…"
          }
        }
      }
    },
    "Asking price" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wunschpreis"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prix demandé"
          }
        },
        "it" : {
