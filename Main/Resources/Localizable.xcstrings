        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo consulente di carriera ti aiuta a trovare un lavoro che ti piacerà."
          }
        }
      }
    },
    "Your chance goes up with the skills below, your %lld years of work%@, and the %@ fame you already have — being known in a field makes the next project there easier." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Deine Chance steigt mit den Fähigkeiten unten, deinem einen Jahr Arbeit%2$@ und dem Ruhm in %3$@, den du schon hast – wer in einem Bereich bekannt ist, hat es beim nächsten Projekt dort leichter."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Deine Chance steigt mit den Fähigkeiten unten, deinen %1$lld Jahren Arbeit%2$@ und dem Ruhm in %3$@, den du schon hast – wer in einem Bereich bekannt ist, hat es beim nächsten Projekt dort leichter."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your chance goes up with the skills below, your %1$lld year of work%2$@, and the %3$@ fame you already have — being known in a field makes the next project there easier."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Your chance goes up with the skills below, your %1$lld years of work%2$@, and the %3$@ fame you already have — being known in a field makes the next project there easier."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "La tua probabilità sale con le competenze qui sotto, il tuo anno di lavoro%2$@ e la fama nel settore %3$@ che hai già — avere fama in un settore rende più facile il progetto successivo in quel settore."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "La tua probabilità sale con le competenze qui sotto, i tuoi %1$lld anni di lavoro%2$@ e la fama nel settore %3$@ che hai già — avere fama in un settore rende più facile il progetto successivo in quel settore."
                }
              }
            }
          }
        }
      }
    },
    "Your chance of admission: %@ at the top school, %@ at the mainstream one." : {
