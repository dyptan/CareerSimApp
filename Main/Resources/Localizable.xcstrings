            "value" : "芸術"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мистецтво"
          }
        }
      }
    },
    "Arts & Minds" : {
      "comment" : "Activities tab: creative and mental disciplines such as music, chess and coding",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kunst & Köpfchen"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arte e mente"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アート＆頭脳"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Творчість і розум"
          }
        }
      }
    },
    "Ask for a salary" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gehaltswunsch nennen"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi uno stipendio"
          }
        }
      }
    },
    "Ask investors to put money into your company. If they say yes, the company grows — and so does your share of it. If they say no, you've spent the year trying." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte Investoren, Geld in dein Unternehmen zu stecken. Sagen sie ja, wächst das Unternehmen – und dein Anteil daran wächst mit. Sagen sie nein, hat der Versuch dein Jahr verbraucht."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi agli investitori di mettere denaro nella tua azienda. Se dicono di sì, l’azienda cresce — e con lei cresce anche la tua quota. Se dicono di no, hai passato l’anno a provarci."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попроси інвесторів вкласти гроші у твою компанію. Якщо вони погодяться, компанія зросте — а разом із нею і твоя частка. Якщо ні, цей рік піде на спроби."
          }
        }
      }
    },
    "Ask me anything…" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Frag mich etwas…"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedimi quello che vuoi…"
          }
        }
      }
    },
    "Asking price" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wunschpreis"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prezzo richiesto"
          }
        }
      }
    },
    "Associate of Applied Science in %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associate of Applied Science in %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Associate degree in scienze applicate: %@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Асоційований ступінь із прикладних наук за напрямом «%@»"
          }
        }
      }
    },
    "At a large company the CTO is usually a senior engineering leader — a VP or head of engineering who has run big teams and budgets. At a start-up it is often a co-founder." : {
      "comment" : "CTO note, point 1 (who becomes CTO): the real-world claim, for adults. General claim",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In una grande azienda il CTO è di solito un alto dirigente dell’ingegneria — un VP o un responsabile dell’ingegneria che ha guidato grandi team e budget. In una startup è spesso un cofondatore."
          }
        }
      }
    },
    "At airlines, seniority decides who flies the bigger aircraft and who becomes a captain — years of service count for more than talent." : {
      "comment" : "Airline pilot note, point 2 (seniority): the real-world claim, for adults. General claim",
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelle compagnie aeree l’anzianità decide chi pilota gli aerei più grandi e chi diventa comandante — gli anni di servizio contano più del talento."
          }
        }
      }
    },
    "At an event you ask to go on stage — to give a talk, perform or pitch. 🎲 is your chance they say yes." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei einem Event bittest du darum, auf die Bühne zu dürfen – für einen Vortrag, einen Auftritt oder einen Pitch. 🎲 ist deine Chance, dass sie zusagen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A un evento chiedi di salire sul palco — per tenere un intervento, esibirti o presentare un’idea. 🎲 è la probabilità che dicano di sì."
          }
        }
      }
    },
    "At today's skills, fame, network and school your application is %@ of a top candidate's." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con le competenze, la fama, i contatti e la scuola di oggi, la tua candidatura vale %@ di quella di un candidato al top."
          }
        }
      }
    },
    "Atestat" : {
      "comment" : "School term: school-leaving qualification or high school (Ukraine).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atestat"
          }
        },
        "it" : {
