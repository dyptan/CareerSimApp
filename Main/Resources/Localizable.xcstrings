    "Get %@. It's the longest step, so start early." : {
      "comment" : "Advisor step. The argument is a qualification as a noun phrase, e.g. 'a bachelor's degree in Business'",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir %@. Das ist der längste Schritt – fang also früh an."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obtiens %@. C’est l’étape la plus longue, alors commence tôt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ottieni %@. È il passo più lungo, quindi inizia presto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@を取りましょう。いちばん時間がかかるステップなので、早めに始めましょう。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здобудь %@. Це найдовший крок, тож починай якомога раніше."
          }
        }
      }
    },
    "Get a spot on a TV show and let everyone see you." : {
      "localizations" : {
        "de" : {
