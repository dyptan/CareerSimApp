        }
      }
    },
    "Sensing how others feel and responding with care." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spüren, wie sich andere fühlen, und fürsorglich reagieren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentir ce que ressentent les autres et leur répondre avec bienveillance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capire come si sentono gli altri e rispondere con attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相手の気持ちを感じとり、思いやりをもって応える力。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Відчувати, що відчувають інші, і відповідати турботою."
          }
        }
      }
    },
    "Service" : {
      "comment" : "Field of study (degree subject): hospitality, customer service and everyday support roles (the service industry).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dienstleistung"
          }
        },
        "fr" : {
