    "Universities look at it when you apply — the top ones care about it a lot." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universitäten schauen bei deiner Bewerbung darauf – die besten legen großen Wert darauf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les universités la regardent quand tu postules — les meilleures y tiennent beaucoup."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le università ne tengono conto quando ti candidi — le migliori ci tengono molto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大学は出願のときにこれを見ます。トップ校ほど重視します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Університети дивляться на неї під час вступу — найкращі зважають на неї дуже сильно."
          }
        }
      }
    },
    "University" : {
      "comment" : "School term: mainstream university tier (Canada, United Kingdom, Ukraine, Australia).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universität"
          }
        },
        "fr" : {
