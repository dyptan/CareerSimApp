          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сервіс"
          }
        }
      }
    },
    "Sharing the work and pulling together with others." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Arbeit teilen und gemeinsam an einem Strang ziehen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se partager le travail et tirer dans le même sens que les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dividersi il lavoro e fare squadra con gli altri."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仕事を分けあい、みんなで力を合わせる力。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ділити роботу й діяти разом з іншими."
          }
        }
      }
    },
    "Shops and brands show what people will want to buy next." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geschäfte und Marken zeigen, was die Leute als Nächstes kaufen wollen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les magasins et les marques montrent ce que les gens voudront acheter ensuite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Negozi e marchi mostrano che cosa vorrà comprare la gente in futuro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お店やブランドが、次に人びとが買いたくなるものを紹介します。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Магазини та бренди показують, що люди захочуть купувати далі."
          }
        }
      }
    },
    "Short motions, big opinions, a trophy for the best speaker." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurze Thesen, große Meinungen und eine Trophäe für den besten Redner."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De courtes motions, de grandes opinions, un trophée pour le meilleur orateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mozioni brevi, grandi opinioni, un trofeo per il miglior oratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "短い論題、大きな意見。いちばん上手な話し手にトロフィーが贈られます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Короткі тези, великі думки й кубок найкращому оратору."
          }
        }
      }
    },
    "Short stories and essays, judged by published authors." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurzgeschichten und Aufsätze, beurteilt von Autoren mit eigenen Büchern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nouvelles et essais, jugés par des auteurs publiés."
          }
        },
        "it" : {
