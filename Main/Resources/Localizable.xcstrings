          "stringUnit" : {
            "state" : "translated",
            "value" : "Commercial Driver’s License (CDL, permis poids lourd) — obligatoire pour conduire des camions, des bus et de grands véhicules de livraison dans un cadre professionnel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Patente professionale (CDL) — obbligatoria per guidare camion, autobus e grandi veicoli per le consegne come lavoro retribuito."
          }
