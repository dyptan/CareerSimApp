    "Government license to install and repair pipes, drains, and water systems. Earned after an apprenticeship and a journeyman exam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Lizenz, um Rohre, Abflüsse und Wassersysteme zu installieren und zu reparieren. Du erwirbst sie nach einer Ausbildung und einer Gesellenprüfung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitazione statale per installare e riparare tubature, scarichi e impianti idrici. Si ottiene dopo un apprendistato e un esame da idraulico qualificato."
          }
        }
      }
    },
    "Government license to wire buildings safely. Earned after an apprenticeship and an exam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Lizenz, um Gebäude sicher zu verkabeln. Du erwirbst sie nach einer Ausbildung und einer Prüfung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitazione statale per realizzare in sicurezza gli impianti elettrici degli edifici. Si ottiene dopo un apprendistato e un esame."
          }
        }
      }
    },
    "Government license to work as a nurse. Earned after passing a national exam following a nursing degree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Pflege-Lizenz, um als Krankenpfleger zu arbeiten. Du erhältst sie, wenn du nach einem Pflegeabschluss eine nationale Prüfung bestehst."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitazione statale per lavorare come infermiere. Si ottiene superando un esame nazionale dopo una laurea in infermieristica."
          }
        }
      }
    },
    "Government permit to apply restricted-use pesticides on farms or commercial landscapes. Required for many farming, landscaping, and pest-control jobs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflanzenschutz-Sachkunde: die behördliche Erlaubnis, Pestizide mit eingeschränkter Anwendung auf Farmen oder gewerblichen Grünflächen auszubringen. Nötig für viele Jobs in Landwirtschaft, Landschaftsbau und Schädlingsbekämpfung."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizzazione statale per usare pesticidi a impiego limitato in aziende agricole o spazi verdi commerciali. Necessaria per molti lavori in agricoltura, giardinaggio e disinfestazione."
          }
        }
      }
    },
