    "Schools look at your grades, your skills and your prizes over many years, not just one good year." : {
      "comment" : "Health specialist note, point 2: the same fact in a beginner's or child's words",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hochschulen schauen sich deine Noten, deine Fähigkeiten und deine Preise über viele Jahre an, nicht nur ein gutes Jahr."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les écoles regardent tes notes, tes compétences et tes prix sur de nombreuses années, pas seulement sur une bonne année."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le scuole guardano i tuoi voti, le tue competenze e i tuoi premi di molti anni, non solo di un anno buono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "学校は、1年だけがんばったかどうかではなく、何年にもわたる成績やスキル、受賞歴を見ます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Навчальні заклади дивляться на твої оцінки, навички та призи за багато років, а не лише за один вдалий рік."
          }
        }
      }
    },
