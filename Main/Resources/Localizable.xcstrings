        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Jahre öffnen die Tür: %1$lld Jahr in %2$@, und unter etwa %3$@ Jahren zählt nichts. Jeder Job in %4$@ zählt, genauso wie Jahre, in denen du dein eigenes Unternehmen führst."
                }
