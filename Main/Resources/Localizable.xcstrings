          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Analysten arbeiten sehr lange, und viele gehen nach ein paar Jahren."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les nouveaux analystes font de très longues journées, et beaucoup partent au bout de deux ans environ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I nuovi analisti lavorano moltissime ore e in tanti se ne vanno dopo un paio d’anni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新人アナリストはとても長い時間働き、2年ほどで辞める人も多いです。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нові аналітики працюють дуже багато годин, і багато хто йде через пару років."
          }
        }
      }
    },
    "No buyer for your %@ stake at %@ this year" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
