        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Юристи й судді обговорюють закон і гучні справи."
          }
        }
      }
    },
    "Leader" : {
      "comment" : "Name of a skill (ability) the player builds, shown next to a pictogram and used as a playful job-like title. The skill: Helping a group decide and act together.",
