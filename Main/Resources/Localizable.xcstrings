        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impresa «%1$@» chiusa — recuperati %2$@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бізнес «%1$@» закрито — повернуто %2$@"
          }
        }
      }
    },
    "%@ had to close this year. Selling what was left got back %@ — but you still have to pay back any loan." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Unternehmen „%1$@“ musste dieses Jahr schließen. Der Verkauf des Restes brachte %2$@ ein – einen Kredit musst du aber trotzdem zurückzahlen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ had to close this year. Selling what was left got back %2$@ — but you still have to pay back any loan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impresa «%1$@» ha dovuto chiudere quest’anno. Vendendo ciò che restava hai recuperato %2$@ — ma devi comunque restituire l’eventuale prestito."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бізнес «%1$@» довелося закрити цього року. Продаж залишків повернув %2$@ — але кредит, якщо він є, усе одно потрібно погасити."
          }
        }
      }
    },
    "%@ harder than usual" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ schwerer als sonst"
          }
