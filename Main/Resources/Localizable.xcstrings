    "Government license to install and repair pipes, drains, and water systems. Earned after an apprenticeship and a journeyman exam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Lizenz, um Rohre, Abflüsse und Wassersysteme zu installieren und zu reparieren. Du erwirbst sie nach einer Ausbildung und einer Gesellenprüfung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence délivrée par l’État pour installer et réparer les tuyaux, les canalisations et les réseaux d’eau. S’obtient après un apprentissage et un examen de plombier qualifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitazione statale per installare e riparare tubature, scarichi e impianti idrici. Si ottiene dopo un apprendistato e un esame da idraulico qualificato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "水道管や排水管、給水設備の取り付けと修理を行うための国の免許です。見習い期間を経て、一人前の職人の試験に合格すると得られます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Державна ліцензія на встановлення й ремонт труб, каналізації та водопостачання. Здобувається після навчання на виробництві та іспиту на кваліфікованого сантехніка."
          }
        }
      }
    },
    "Government license to wire buildings safely. Earned after an apprenticeship and an exam." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Lizenz, um Gebäude sicher zu verkabeln. Du erwirbst sie nach einer Ausbildung und einer Prüfung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence délivrée par l’État pour réaliser des installations électriques en toute sécurité. S’obtient après un apprentissage et un examen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitazione statale per realizzare in sicurezza gli impianti elettrici degli edifici. Si ottiene dopo un apprendistato e un esame."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "建物の配線を安全に行うための国の免許です。見習い期間を経て、試験に合格すると得られます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Державна ліцензія на безпечну прокладку електропроводки в будівлях. Здобувається після навчання на виробництві та іспиту."
          }
        }
      }
    },
    "Government license to work as a nurse. Earned after passing a national exam following a nursing degree." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Staatliche Pflege-Lizenz, um als Krankenpfleger zu arbeiten. Du erhältst sie, wenn du nach einem Pflegeabschluss eine nationale Prüfung bestehst."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Licence délivrée par l’État pour exercer comme infirmier. S’obtient en réussissant un examen national après un diplôme en soins infirmiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitazione statale per lavorare come infermiere. Si ottiene superando un esame nazionale dopo una laurea in infermieristica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "看護師として働くための国の免許です。看護の学位を修めたあと、国家試験に合格すると得られます。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Державна ліцензія на роботу медсестрою. Здобувається після ступеня з медсестринства та складання національного іспиту."
          }
        }
      }
    },
    "Government permit to apply restricted-use pesticides on farms or commercial landscapes. Required for many farming, landscaping, and pest-control jobs." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pflanzenschutz-Sachkunde: die behördliche Erlaubnis, Pestizide mit eingeschränkter Anwendung auf Farmen oder gewerblichen Grünflächen auszubringen. Nötig für viele Jobs in Landwirtschaft, Landschaftsbau und Schädlingsbekämpfung."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisation officielle d’appliquer des pesticides à usage restreint dans les fermes ou sur des espaces verts commerciaux. Exigée pour de nombreux postes en agriculture, en aménagement paysager et en lutte contre les nuisibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorizzazione statale per usare pesticidi a impiego limitato in aziende agricole o spazi verdi commerciali. Necessaria per molti lavori in agricoltura, giardinaggio e disinfestazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用が制限された農薬を、農場や商業用の緑地でまくための国の許可です。農業、造園、害虫駆除の多くの仕事で必要になります。"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Державний дозвіл на застосування пестицидів обмеженого використання на фермах або комерційних ландшафтах. Потрібен для багатьох робіт у сільському господарстві, озелененні та боротьбі зі шкідниками."
          }
        }
      }
    },
