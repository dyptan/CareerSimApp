          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Робота з людьми — обслуговування, навчання, догляд, виступи."
          }
        }
      }
    },
    "Working problems out: spotting patterns and breaking a puzzle into steps." : {
      "localizations" : {
